{
  "name": "guia-comercial-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "API REST do guia comercial (Express + TypeScript + MongoDB)",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/backend/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "seed": "tsx src/scripts/seed.ts",
    "grant:role": "tsx src/scripts/grant-test-role.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.1.1",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "mongoose": "^9.0.11",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.5.0",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.9",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
