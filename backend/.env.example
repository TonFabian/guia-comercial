# Porta do servidor
PORT=4000

# Conexão com o MongoDB
MONGODB_URI=mongodb://localhost:27017/guia-comercial

# Origins permitidas para CORS (separadas por vírgula).
# Em desenvolvimento, se omitida, qualquer origin é aceita.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Clerk — obrigatórias quando auth ligado. Sem elas a API sobe em modo legado
# (sem autenticação); nunca versione valores reais, use as do dashboard local.
# CLERK_PUBLISHABLE_KEY=pk_test_placeholder
# CLERK_SECRET_KEY=sk_test_placeholder
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_placeholder

# Segredo compartilhado para broadcast de notificações (header x-notify-secret).
# Opcional em dev (validações liberadas); obrigatório em produção.
# NOTIFY_SECRET=segredo_local_placeholder

# Ambiente: development | production
NODE_ENV=development

# E-mails promovidos a admin (separados por vírgula). Opcional.
# ADMIN_EMAILS=admin@exemplo.com,deivid5802@uorak.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# Trust proxy: número de saltos de proxy reverso na frente da API (nginx,
# Cloudflare, load balancer). NUNCA ativar sem proxy real — atacante forjaria
# X-Forwarded-For para burlar o rate limit por IP.
# TRUST_PROXY=1

# Rate limit do webhook do Clerk (única rota fora do limite global).
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=30

# Rate limit anti-inflação das métricas de analytics (por empresa, por IP):
# view 1/hora, whatsapp-click 5/hora e favorite 30/hora por padrão.
ANALYTICS_VIEW_MAX_PER_HOUR=1
ANALYTICS_CLICK_MAX_PER_HOUR=5
ANALYTICS_FAVORITE_MAX_PER_HOUR=30

# ---------------------------------------------------------------------------
# E-mail transacional (avisos do ciclo de planos). Ver docs do email.service.
#
# EMAIL_TRANSPORT: "smtp" (padrão, provisório) ou "http" (serviço próprio).
# Sem SMTP_HOST + SMTP_FROM configurados, o e-mail é pulado (warn no log) —
# o ciclo de planos NUNCA falha por falta de e-mail.
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario_placeholder
# SMTP_PASS=senha_placeholder
# SMTP_FROM=Guia Comercial <no-reply@exemplo.com>

# Transporte "http": POST {to, subject, body, cc, bcc} no serviço próprio do
# usuário (endpoint "emissário"). EMAIL_API_SECRET vai como Bearer token.
# EMAIL_TRANSPORT=http
# EMAIL_API_URL=https://servico-email.exemplo.com/send
# EMAIL_API_SECRET=segredo_placeholder

# URL pública do guia, usada como link do botão nos e-mails do ciclo de planos.
# Sem ela, o botão aponta para "#" (placeholder).
# APP_PUBLIC_URL=https://guia.exemplo.com

# Chave de emergência: "true" desliga o cron do ciclo de planos (07:00
# America/Sao_Paulo) sem precisar de novo deploy. Padrão = ligado.
# PLAN_LIFECYCLE_DISABLED=true

# Push Center (admin): "true" desliga os crons de campanhas agendadas e receipts.
PUSH_CENTER_DISABLED=false
# Limite de criação de campanhas por admin por hora.
PUSH_CAMPAIGN_MAX_PER_HOUR=10

# ---------------------------------------------------------------------------
# Redis (rate limit compartilhado / cache). Usado pelo backend em produção
# quando REDIS_URL estiver definido.
#
# REDIS_URL é "local-dev only": aponta para redis://localhost:6379 em dev.
# Em produção (docker-compose) o entrypoint reconstrói REDIS_URL para
# redis://:${REDIS_PASSWORD}@redis:6379 a partir de REDIS_PASSWORD em runtime
# (o compose não interpola REDIS_URL via environment).
# REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=change-me-in-production
