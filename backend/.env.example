# Porta do servidor
PORT=4000

# Conexão com o MongoDB
MONGODB_URI=mongodb://localhost:27017/guia-comercial

# Origins permitidas para CORS (separadas por vírgula).
# Em desenvolvimento, se omitida, qualquer origin é aceita.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Clerk — obrigatórias quando auth ligado. Sem elas a API sobe em modo legado
# (sem autenticação); nunca versione valores reais, use as do dashboard local.
# CLERK_PUBLISHABLE_KEY=pk_test_placeholder
# CLERK_SECRET_KEY=sk_test_placeholder
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_placeholder

# Segredo compartilhado para broadcast de notificações (header x-notify-secret).
# Opcional em dev (validações liberadas); obrigatório em produção.
# NOTIFY_SECRET=segredo_local_placeholder

# Ambiente: development | production
NODE_ENV=development

# E-mails promovidos a admin (separados por vírgula). Opcional.
# ADMIN_EMAILS=admin@exemplo.com,deivid5802@uorak.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
